transition:stroke-dashoffset 0.9s cubic-bezier(0.2,0.7,0.2,1)\"></path></svg><p class=\"-mt-1 text-xs font-semibold\">LCP<!-- --> <span class=\"font-mono text-muted\">—</span></p><p class=\"text-[10px] text-muted\">waiting</p></div><div class=\"text-center\"><svg viewBox=\"0 0 100 58\" class=\"mx-auto w-24\" aria-hidden=\"true\"><path d=\"M10 50 A40 40 0 0 1 90 50\" fill=\"none\" stroke=\"var(--line)\" stroke-width=\"9\" stroke-linecap=\"round\"></path><path d=\"M10 50 A40 40 0 0 1 90 50\" fill=\"none\" stroke=\"var(--good)\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-dasharray=\"125.66370614359172\" stroke-dashoffset=\"125.66370614359172\" style=\"transition:stroke-dashoffset 0.9s cubic-bezier(0.2,0.7,0.2,1)\"></path></svg><p class=\"-mt-1 text-xs font-semibold\">INP<!-- --> <span class=\"font-mono text-muted\">—</span></p><p class=\"text-[10px] text-muted\">waiting</p></div><div class=\"text-center\"><svg viewBox=\"0 0 100 58\" class=\"mx-auto w-24\" aria-hidden=\"true\"><path d=\"M10 50 A40 40 0 0 1 90 50\" fill=\"none\" stroke=\"var(--line)\" stroke-width=\"9\" stroke-linecap=\"round\"></path><path d=\"M10 50 A40 40 0 0 1 90 50\" fill=\"none\" stroke=\"var(--good)\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-dasharray=\"125.66370614359172\" stroke-dashoffset=\"125.66370614359172\" style=\"transition:stroke-dashoffset 0.9s cubic-bezier(0.2,0.7,0.2,1)\"></path></svg><p class=\"-mt-1 text-xs font-semibold\">CLS<!-- --> <span class=\"font-mono text-muted\">—</span></p><p class=\"text-[10px] text-muted\">waiting</p></div></div></div><div class=\"flex flex-col p-5\"><p class=\"eyebrow\">Score by section</p><svg viewBox=\"0 0 200 200\" class=\"mx-auto mt-1 w-full max-w-[17rem]\" role=\"img\" aria-label=\"Section scores radar chart\"><polygon points=\"100,83.5 115.69243251887004,94.90121959281336 109.6984566628258,113.34878040718664 90.3015433371742,113.34878040718664 84.30756748112996,94.90121959281338\" fill=\"none\" stroke=\"var(--line)\"></polygon><polygon points=\"100,67 131.38486503774007,89.80243918562674 119.39691332565161,126.69756081437326 80.60308667434839,126.69756081437326 68.61513496225993,89.80243918562674\" fill=\"none\" stroke=\"var(--line)\"></polygon><polygon points=\"100,50.5 147.0772975566101,84.7036587784401 129.09536998847742,140.04634122155989 70.90463001152258,140.04634122155989 52.922702443389895,84.70365877844011\" fill=\"none\" stroke=\"var(--line)\"></polygon><polygon points=\"100,34 162.76973007548014,79.60487837125348 138.79382665130322,153.39512162874652 61.20617334869678,153.39512162874652 37.23026992451986,79.60487837125348\" fill=\"none\" stroke=\"var(--line)\"></polygon><line x1=\"100\" y1=\"100\" x2=\"100\" y2=\"34\" stroke=\"var(--line)\"></line><line x1=\"100\" y1=\"100\" x2=\"162.76973007548014\" y2=\"79.60487837125348\" stroke=\"var(--line)\"></line><line x1=\"100\" y1=\"100\" x2=\"138.79382665130322\" y2=\"153.39512162874652\" stroke=\"var(--line)\"></line><line x1=\"100\" y1=\"100\" x2=\"61.20617334869678\" y2=\"153.39512162874652\" stroke=\"var(--line)\"></line><line x1=\"100\" y1=\"100\" x2=\"37.23026992451986\" y2=\"79.60487837125348\" stroke=\"var(--line)\"></line><polygon points=\"100,100 100,100 100,100 100,100 100,100\" fill=\"var(--accent)\" fill-opacity=\"0.2\" stroke=\"var(--accent)\" stroke-width=\"2.5\" stroke-linejoin=\"round\"></polygon><circle cx=\"100\" cy=\"100\" r=\"3.5\" fill=\"var(--accent)\" stroke=\"var(--surface)\" stroke-width=\"1.5\"></circle><circle cx=\"100\" cy=\"100\" r=\"3.5\" fill=\"var(--accent)\" stroke=\"var(--surface)\" stroke-width=\"1.5\"></circle><circle cx=\"100\" cy=\"100\" r=\"3.5\" fill=\"var(--accent)\" stroke=\"var(--surface)\" stroke-width=\"1.5\"></circle><circle cx=\"100\" cy=\"100\" r=\"3.5\" fill=\"var(--accent)\" stroke=\"var(--surface)\" stroke-width=\"1.5\"></circle><circle cx=\"100\" cy=\"100\" r=\"3.5\" fill=\"var(--accent)\" stroke=\"var(--surface)\" stroke-width=\"1.5\"></circle><text x=\"100\" y=\"20\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--muted)\" font-weight=\"600\">On-page</text><text x=\"178.93769085249772\" y=\"77.35158946687937\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--muted)\" font-weight=\"600\">Indexing</text><text x=\"148.78617594027526\" y=\"170.14841053312063\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--muted)\" font-weight=\"600\">Social</text><text x=\"51.213824059724736\" y=\"170.14841053312063\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--muted)\" font-weight=\"600\">Content</text><text x=\"21.062309147502248\" y=\"77.35158946687937\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"var(--muted)\" font-weight=\"600\">Technical</text></svg><ul class=\"mt-3 space-y-1.5 text-xs\"><li class=\"text-muted\">Waiting for the first check…</li></ul><div class=\"mt-auto rounded-xl border border-accent/30 bg-accent/5 p-3 text-sm transition-all duration-500 translate-y-2 opacity-0\"><p class=\"eyebrow text-accent\">Top fix</p><p class=\"mt-0.5 font-medium\">Add alt text to 3 images</p><p class=\"text-xs text-muted\">Content · impact medium · +5 points</p></div></div></div><figcaption class=\"border-t border-line px-4 py-2 text-[11px] text-muted\">Illustrative sample. Your report uses live data from the URL you enter.</figcaption></div></figure></section><section id=\"how-it-works\" class=\"scroll-mt-20 py-16\"><p class=\"eyebrow text-accent\" data-reveal=\"true\">How it works</p><h2 class=\"mt-2 text-3xl sm:text-4xl\" data-reveal=\"true\">From URL to fixes in three steps</h2><ol class=\"mt-8 grid gap-4 sm:grid-cols-3\"><li data-reveal=\"true\" style=\"--d:0ms\" class=\"card card-hover spot p-6\"><span class=\"grid h-10 w-10 place-items-center rounded-lg bg-accent text-lg font-bold text-on-accent\">1</span><h3 class=\"mt-4 text-lg font-semibold\">Enter a URL</h3><p class=\"mt-1 text-muted\">Paste any public page address. We validate it and refuse private or internal targets.</p></li><li data-reveal=\"true\" style=\"--d:90ms\" class=\"card card-hover spot p-6\"><span class=\"grid h-10 w-10 place-items-center rounded-lg bg-accent text-lg font-bold text-on-accent\">2</span><h3 class=\"mt-4 text-lg font-semibold\">We fetch and inspect it live</h3><p class=\"mt-1 text-muted\">The page is downloaded fresh and parsed. You watch each stage as it happens.</p></li><li data-reveal=\"true\" style=\"--d:180ms\" class=\"card card-hover spot p-6\"><span class=\"grid h-10 w-10 place-items-center rounded-lg bg-accent text-lg font-bold text-on-accent\">3</span><h3 class=\"mt-4 text-lg font-semibold\">Read, fix, download</h3><p class=\"mt-1 text-muted\">Browse one page per module, work through prioritised fixes, then export the full report.</p></li></ol></section><section id=\"modules\" class=\"scroll-mt-20 py-12\" aria-labelledby=\"index\"><p class=\"eyebrow text-accent\" data-reveal=\"true\">Coverage</p><h2 id=\"index\" class=\"mt-2 text-3xl sm:text-4xl\" data-reveal=\"true\">What gets checked</h2><p class=\"mt-2 max-w-xl text-muted\" data-reveal=\"true\">Each module has its own page, with its checks, evidence and recommendations.</p><div><div class=\"mt-6 flex flex-wrap gap-2\" role=\"tablist\" aria-label=\"Filter modules\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-accent bg-accent text-on-accent shadow-[var(--shadow-sm)]\">All<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">21</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">On-page<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">2</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">Indexing<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">1</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">Social<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">3</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">Content<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">5</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">Accessibility<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">1</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">Rendering<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">1</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">Technical<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">2</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-sm font-medium transition border-line bg-surface text-muted hover:border-accent/50 hover:text-ink\">Site &amp; market<span class=\"ml-1.5 font-mono text-[11px] opacity-70\">6</span></button></div><div class=\"mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\"><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 0ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">On-page</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Title tag</h3><p class=\"mt-1 text-sm text-muted\">The title is the main headline for the page in search results and browser tabs.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 30ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">On-page</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Meta description</h3><p class=\"mt-1 text-sm text-muted\">The description is frequently used as the snippet beneath a search result.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 60ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Indexing</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Canonical URL</h3><p class=\"mt-1 text-sm text-muted\">The canonical link names the preferred URL; robots directives control whether the page is indexed.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 90ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Social</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Open Graph</h3><p class=\"mt-1 text-sm text-muted\">Open Graph tags decide how the page looks when shared on social and messaging apps.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 120ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Social</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Twitter / X Cards</h3><p class=\"mt-1 text-sm text-muted\">Twitter Card tags control the preview shown on X.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 150ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Content</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Images</h3><p class=\"mt-1 text-sm text-muted\">Image sources and alternative text found in the HTML.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 180ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Content</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Links</h3><p class=\"mt-1 text-sm text-muted\">Internal and external links discovered on the page.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 210ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Content</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Structured data</h3><p class=\"mt-1 text-sm text-muted\">JSON-LD blocks discovered and parsed from the page.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 240ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Content</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Content quality</h3><p class=\"mt-1 text-sm text-muted\">Heading structure, reading ease, sentence length and keyword density of the visible text.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 270ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Accessibility</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Accessibility</h3><p class=\"mt-1 text-sm text-muted\">Labels, names, landmarks and markup that screen readers and other assistive tools depend on.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 300ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Rendering</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">JavaScript rendering</h3><p class=\"mt-1 text-sm text-muted\">Compares the raw server HTML with the live, JavaScript-rendered page.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 330ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Technical</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Technical signals</h3><p class=\"mt-1 text-sm text-muted\">HTTP response, HTTPS, viewport and language declarations.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 360ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Technical</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Performance &amp; Core Web Vitals</h3><p class=\"mt-1 text-sm text-muted\">Lighthouse lab test plus real-user field data from Google, mobile and desktop.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 390ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Content</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Broken links</h3><p class=\"mt-1 text-sm text-muted\">Every link on the page is requested live and checked for errors and redirects.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 420ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Social</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Social profiles</h3><p class=\"mt-1 text-sm text-muted\">Finds every Facebook, Instagram, X, LinkedIn, YouTube and other social link and checks each one is a real, working profile.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 450ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Site &amp; market</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">AI &amp; crawler access</h3><p class=\"mt-1 text-sm text-muted\">Which AI and search crawlers robots.txt allows, and whether llms.txt exists.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 480ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Site &amp; market</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Site-wide issues</h3><p class=\"mt-1 text-sm text-muted\">Crawls internal pages for duplicate titles, missing descriptions and thin content.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 510ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Site &amp; market</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Keywords overview</h3><p class=\"mt-1 text-sm text-muted\">Primary keywords found on the page plus platform-focused keyword ideas.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 540ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Site &amp; market</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Sitemap &amp; robots</h3><p class=\"mt-1 text-sm text-muted\">Reads robots.txt and the XML sitemap live and checks them against the pages found.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 570ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Site &amp; market</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Security &amp; infrastructure</h3><p class=\"mt-1 text-sm text-muted\">Security headers, TLS certificate, DNS and email records, domain age and hosting.</p></button><button type=\"button\" aria-expanded=\"false\" style=\"animation:rise 0.35s ease-out 600ms both\" class=\"card card-hover spot p-5 text-left \"><div class=\"flex items-center justify-between\"><span class=\"rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-muted\">Site &amp; market</span><span class=\"grid h-6 w-6 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition \">+</span></div><h3 class=\"mt-3 font-semibold\">Traffic overview</h3><p class=\"mt-1 text-sm text-muted\">Worldwide popularity rank and a six-month trend from the Tranco list.</p></button></div></div></section><section id=\"features\" class=\"scroll-mt-20 py-16\"><p class=\"eyebrow text-accent\" data-reveal=\"true\">Why it&#x27;s different</p><h2 class=\"mt-2 text-3xl sm:text-4xl\" data-reveal=\"true\">Built to be trusted</h2><ul class=\"mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3\"><li data-reveal=\"true\" style=\"--d:0ms\" class=\"card card-hover spot p-6\"><h3 class=\"font-semibold\">Evidence for every finding</h3><p class=\"mt-1 text-sm text-muted\">Each check shows the exact title, tag or value it found — nothing is a black box.</p></li><li data-reveal=\"true\" style=\"--d:70ms\" class=\"card card-hover spot p-6\"><h3 class=\"font-semibold\">Fixes ranked by impact</h3><p class=\"mt-1 text-sm text-muted\">Issues are ordered by impact × confidence so you know what to change first.</p></li><li data-reveal=\"true\" style=\"--d:140ms\" class=\"card card-hover spot p-6\"><h3 class=\"font-semibold\">Honest coverage</h3><p class=\"mt-1 text-sm text-muted\">Checks that do not apply or were not measured are labelled, never faked or silently scored.</p></li><li data-reveal=\"true\" style=\"--d:0ms\" class=\"card card-hover spot p-6\"><h3 class=\"font-semibold\">Twenty-three focused pages</h3><p class=\"mt-1 text-sm text-muted\">On-page, indexing, social, content, accessibility, rendering, performance, links, sitemap, security, keywords and traffic.</p></li><li data-reveal=\"true\" style=\"--d:70ms\" class=\"card card-hover spot p-6\"><h3 class=\"font-semibold\">Server HTML analysis</h3><p class=\"mt-1 text-sm text-muted\">Fetches each page and parses its returned HTML with Cheerio; JavaScript execution is not available on Workers.</p></li><li data-reveal=\"true\" style=\"--d:140ms\" class=\"card card-hover spot p-6\"><h3 class=\"font-semibold\">Download everything</h3><p class=\"mt-1 text-sm text-muted\">Full report as HTML, PDF, Markdown, CSV or JSON — ready to share with a client or ticket.</p></li><li data-reveal=\"true\" style=\"--d:0ms\" class=\"card card-hover spot p-6\"><h3 class=\"font-semibold\">Safe by design</h3><p class=\"mt-1 text-sm text-muted\">Strict network safeguards block private addresses, unsafe redirects and oversized responses.</p></li></ul></section><section id=\"method\" class=\"scroll-mt-20 py-8\"><div class=\"card p-6 sm:p-8\" data-reveal=\"true\"><div class=\"flex flex-wrap items-end justify-between gap-3\"><div><h2 class=\"text-2xl\">How the score works</h2><p class=\"mt-1 max-w-xl text-muted\">Pass earns full weight, warning half, fail zero. Checks that don&#x27;t apply are left out, and every report says how many ran. Toggle the optional modules to see how the weighting changes.</p></div><div class=\"text-right\"><div class=\"text-4xl font-semibold tabular-nums text-accent\">161</div><div class=\"text-xs text-muted\">weighted points in play</div></div></div><div class=\"mt-6 flex h-4 overflow-hidden rounded-full bg-panel-2\" role=\"img\" aria-label=\"Score weighting\"><button type=\"button\" aria-label=\"HTML checks: 102 points\" class=\"bg-accent h-full transition-all duration-500 brightness-110\" style=\"width:63.35403726708074%\"></button><button type=\"button\" aria-label=\"Performance: 25 points\" class=\"bg-good h-full transition-all duration-500 opacity-70 hover:opacity-100\" style=\"width:15.527950310559005%\"></button><button type=\"button\" aria-label=\"Link health: 10 points\" class=\"bg-warn h-full transition-all duration-500 opacity-70 hover:opacity-100\" style=\"width:6.211180124223603%\"></button><button type=\"button\" aria-label=\"Site health: 10 points\" class=\"bg-bad h-full transition-all duration-500 opacity-70 hover:opacity-100\" style=\"width:6.211180124223603%\"></button><button type=\"button\" aria-label=\"Security: 8 points\" class=\"bg-accent/60 h-full transition-all duration-500 opacity-70 hover:opacity-100\" style=\"width:4.968944099378882%\"></button><button type=\"button\" aria-label=\"Sitemap &amp; robots: 6 points\" class=\"bg-good/60 h-full transition-all duration-500 opacity-70 hover:opacity-100\" style=\"width:3.7267080745341614%\"></button></div><div class=\"mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm\"><button type=\"button\" class=\"inline-flex items-center gap-2 font-semibold\"><span class=\"h-2.5 w-2.5 rounded-full bg-accent\"></span>HTML checks<!-- --> <span class=\"font-mono text-xs\">102</span></button><button type=\"button\" class=\"inline-flex items-center gap-2 text-muted\"><span class=\"h-2.5 w-2.5 rounded-full bg-good\"></span>Performance<!-- --> <span class=\"font-mono text-xs\">25</span></button><button type=\"button\" class=\"inline-flex items-center gap-2 text-muted\"><span class=\"h-2.5 w-2.5 rounded-full bg-warn\"></span>Link health<!-- --> <span class=\"font-mono text-xs\">10</span></button><button type=\"button\" class=\"inline-flex items-center gap-2 text-muted\"><span class=\"h-2.5 w-2.5 rounded-full bg-bad\"></span>Site health<!-- --> <span class=\"font-mono text-xs\">10</span></button><button type=\"button\" class=\"inline-flex items-center gap-2 text-muted\"><span class=\"h-2.5 w-2.5 rounded-full bg-accent/60\"></span>Security<!-- --> <span class=\"font-mono text-xs\">8</span></button><button type=\"button\" class=\"inline-flex items-center gap-2 text-muted\"><span class=\"h-2.5 w-2.5 rounded-full bg-good/60\"></span>Sitemap &amp; robots<!-- --> <span class=\"font-mono text-xs\">6</span></button></div><div class=\"mt-5 grid gap-4 border-t border-line pt-5 sm:grid-cols-[1.2fr_1fr]\"><div class=\"rise\"><p class=\"font-semibold text-accent\">HTML checks<!-- --> · <!-- -->102<!-- --> points</p><p class=\"mt-1 text-muted\">Titles, descriptions, headings, content quality, accessibility, canonical, URLs, links, images, social cards, structured data and technical signals, read from the HTML. Each check is graded strictly: thin content, generic link text or missing image sizes all lose points.</p></div><div><p class=\"eyebrow\">Optional modules</p><div class=\"mt-2 flex flex-wrap gap-2\"><button type=\"button\" role=\"switch\" aria-checked=\"true\" class=\"inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition border-accent/50 bg-accent/10 font-medium\"><span class=\"h-2 w-2 rounded-full bg-good\"></span>Performance</button><button type=\"button\" role=\"switch\" aria-checked=\"true\" class=\"inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition border-accent/50 bg-accent/10 font-medium\"><span class=\"h-2 w-2 rounded-full bg-warn\"></span>Link health</button><button type=\"button\" role=\"switch\" aria-checked=\"true\" class=\"inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition border-accent/50 bg-accent/10 font-medium\"><span class=\"h-2 w-2 rounded-full bg-bad\"></span>Site health</button><button type=\"button\" role=\"switch\" aria-checked=\"true\" class=\"inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition border-accent/50 bg-accent/10 font-medium\"><span class=\"h-2 w-2 rounded-full bg-accent/60\"></span>Security</button><button type=\"button\" role=\"switch\" aria-checked=\"true\" class=\"inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition border-accent/50 bg-accent/10 font-medium\"><span class=\"h-2 w-2 rounded-full bg-good/60\"></span>Sitemap &amp; robots</button></div><p class=\"mt-3 text-xs text-muted\">It is an audit score from a published rubric, not a Google ranking score.</p></div></div></div></section><section id=\"about\" class=\"scroll-mt-20 py-16\"><div class=\"grid gap-8 sm:grid-cols-[1fr_1.5fr]\"><div data-reveal=\"true\"><p class=\"eyebrow text-accent\">About us</p><h2 class=\"mt-2 text-3xl sm:text-4xl\">Show the work.</h2></div><div class=\"space-y-3 text-muted\" data-reveal=\"true\" style=\"--d:80ms\"><p>Most SEO tools hand you one number and a pile of warnings. We think a score is only useful if you can see what produced it. SEO Audit Analyzer reports the exact value found on your page, explains why it matters, and says plainly what it did not measure.</p><p>Everything runs on free, public data sources, and anything we cannot measure is labelled as such rather than estimated.</p><p><a class=\"font-medium text-accent underline underline-offset-4\" href=\"/about\">Read more about us →</a></p></div></div></section><section id=\"faq\" class=\"scroll-mt-20 py-8\"><p class=\"eyebrow text-accent\" data-reveal=\"true\">FAQ</p><h2 class=\"mt-2 text-3xl sm:text-4xl\" data-reveal=\"true\">Frequently asked questions</h2><div class=\"mt-8 grid gap-3\"><details data-reveal=\"true\" style=\"--d:0ms\" class=\"card group px-5 py-4 transition open:shadow-[var(--shadow)]\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&amp;::-webkit-details-marker]:hidden\">Is the score a Google ranking score?<span aria-hidden=\"true\" class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition group-open:rotate-45 group-open:bg-accent group-open:text-on-accent\">+</span></summary><p class=\"mt-3 max-w-3xl text-muted\">No. It is a custom audit score from a published rubric (version 2026.3). It shows how a page performs against those checks and does not predict or guarantee rankings.</p></details><details data-reveal=\"true\" style=\"--d:50ms\" class=\"card group px-5 py-4 transition open:shadow-[var(--shadow)]\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&amp;::-webkit-details-marker]:hidden\">Does it check JavaScript-rendered content?<span aria-hidden=\"true\" class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition group-open:rotate-45 group-open:bg-accent group-open:text-on-accent\">+</span></summary><p class=\"mt-3 max-w-3xl text-muted\">No. The Cloudflare Workers deployment analyzes server-returned HTML and does not execute page JavaScript.</p></details><details data-reveal=\"true\" style=\"--d:100ms\" class=\"card group px-5 py-4 transition open:shadow-[var(--shadow)]\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&amp;::-webkit-details-marker]:hidden\">Are results live or cached?<span aria-hidden=\"true\" class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition group-open:rotate-45 group-open:bg-accent group-open:text-on-accent\">+</span></summary><p class=\"mt-3 max-w-3xl text-muted\">Live. Every analysis fetches the page at that moment, and the report shows the exact time it was generated.</p></details><details data-reveal=\"true\" style=\"--d:150ms\" class=\"card group px-5 py-4 transition open:shadow-[var(--shadow)]\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&amp;::-webkit-details-marker]:hidden\">Do I need an account?<span aria-hidden=\"true\" class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition group-open:rotate-45 group-open:bg-accent group-open:text-on-accent\">+</span></summary><p class=\"mt-3 max-w-3xl text-muted\">No. There are no accounts. Your current report lives in your browser tab and is cleared when you close it.</p></details><details data-reveal=\"true\" style=\"--d:200ms\" class=\"card group px-5 py-4 transition open:shadow-[var(--shadow)]\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&amp;::-webkit-details-marker]:hidden\">Does it measure performance?<span aria-hidden=\"true\" class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition group-open:rotate-45 group-open:bg-accent group-open:text-on-accent\">+</span></summary><p class=\"mt-3 max-w-3xl text-muted\">Yes. A Lighthouse lab test and real-user Core Web Vitals from Google&#x27;s free APIs run automatically after the audit and feed the overall score. Backlink counts need a paid index and are not included.</p></details><details data-reveal=\"true\" style=\"--d:250ms\" class=\"card group px-5 py-4 transition open:shadow-[var(--shadow)]\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&amp;::-webkit-details-marker]:hidden\">Can I analyse any website?<span aria-hidden=\"true\" class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-panel-2 text-lg leading-none text-muted transition group-open:rotate-45 group-open:bg-accent group-open:text-on-accent\">+</span></summary><p class=\"mt-3 max-w-3xl text-muted\">Any public http or https page you are permitted to test. Private network addresses and non-HTML responses are rejected.</p></details></div></section><section data-reveal=\"true\" class=\"relative my-16 overflow-hidden rounded-lg border border-line bg-surface p-7 text-center shadow-[var(--shadow-sm)] sm:p-10\"><h2 class=\"mx-auto max-w-xl text-3xl sm:text-4xl\">See what your page is really telling search engines.</h2><p class=\"mx-auto mt-3 max-w-md text-muted\">Free, live and no sign-up. Takes a few seconds.</p><a href=\"#url-hero\" class=\"btn btn-primary mt-7 px-6 py-3 text-base\">Audit a page →</a></section></main><footer class=\"no-print mt-24 border-t border-line bg-surface/60\"><div class=\"mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:grid-cols-[1.4fr_repeat(3,1fr)]\"><div><a class=\"group flex items-center gap-2.5 text-ink\" aria-label=\"SEO Audit Analyzer home\" href=\"/\"><svg viewBox=\"0 0 64 64\" class=\"h-8 w-8 transition-transform duration-300 group-hover:rotate-[-6deg] group-hover:scale-105\" aria-hidden=\"true\"><defs><linearGradient id=\"audit-mark\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#142c43\"></stop><stop offset=\"1\" stop-color=\"#1c5269\"></stop></linearGradient></defs><rect width=\"64\" height=\"64\" rx=\"18\" fill=\"url(#audit-mark)\"></rect><circle cx=\"32\" cy=\"32\" r=\"20\" fill=\"none\" stroke=\"#8bd8e3\" stroke-opacity=\".25\" stroke-width=\"2\"></circle><path d=\"M15 39h8l6-14 8 20 6-13h6\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><circle cx=\"49\" cy=\"32\" r=\"4\" fill=\"#65d6c5\"></circle></svg><span class=\"text-[16px] font-bold tracking-tight sm:text-[17px]\">SEO Audit <span class=\"text-accent\">Analyzer</span></span></a><p class=\"mt-3 max-w-xs text-sm text-muted\">Evidence-backed SEO audits<!-- -->. Every score comes with the evidence, the reasoning and a fix.</p></div><nav aria-label=\"Product\"><h2 class=\"eyebrow\">Product</h2><ul class=\"mt-3 space-y-2 text-sm\"><li><a class=\"text-muted transition hover:text-accent\" href=\"/#how-it-works\">How it works</a></li><li><a class=\"text-muted transition hover:text-accent\" href=\"/#modules\">What gets checked</a></li><li><a class=\"text-muted transition hover:text-accent\" href=\"/#features\">Features</a></li><li><a class=\"text-muted transition hover:text-accent\" href=\"/#method\">Scoring method</a></li></ul></nav><nav aria-label=\"Company\"><h2 class=\"eyebrow\">Company</h2><ul class=\"mt-3 space-y-2 text-sm\"><li><a class=\"text-muted transition hover:text-accent\" href=\"/about\">About us</a></li><li><a class=\"text-muted transition hover:text-accent\" href=\"/contact\">Contact</a></li><li><a class=\"text-muted transition hover:text-accent\" href=\"/#faq\">FAQ</a></li></ul></nav><nav aria-label=\"Legal\"><h2 class=\"eyebrow\">Legal</h2><ul class=\"mt-3 space-y-2 text-sm\"><li><a class=\"text-muted transition hover:text-accent\" href=\"/privacy\">Privacy policy</a></li><li><a class=\"text-muted transition hover:text-accent\" href=\"/terms\">Terms of use</a></li></ul></nav></div><div class=\"border-t border-line\"><div class=\"mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 text-xs text-muted sm:flex-row sm:justify-between\"><p>© <!-- -->2026<!-- --> <!-- -->SEO Audit Analyzer<!-- -->. Scoring rubric 2026.3.</p><p>Audit scores are not Google ranking scores. Not affiliated with Google.</p></div></div></footer></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-1396ad735eba86b9.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[5668,[\\\"668\\\",\\\"static/chunks/668-7f6f4e4703d7fcca.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-8b451254ab9cfb9a.js\\\"],\\\"ReportProvider\\\"]\\n3:I[9766,[],\\\"\\\"]\\n4:I[8924,[],\\\"\\\"]\\n5:I[6309,[\\\"668\\\",\\\"static/chunks/668-7f6f4e4703d7fcca.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-8b451254ab9cfb9a.js\\\"],\\\"default\\\"]\\n6:I[9903,[\\\"668\\\",\\\"static/chunks/668-7f6f4e