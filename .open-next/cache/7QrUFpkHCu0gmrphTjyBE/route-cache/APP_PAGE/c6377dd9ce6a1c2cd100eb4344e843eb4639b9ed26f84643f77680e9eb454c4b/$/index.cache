ttp-status\",\"https\",\"viewport\",\"html-lang\",\"charset\",\"url-quality\",\"mixed-content\",\"compression\",\"country-targeting\"]},{\"slug\":\"performance\",\"label\":\"Performance & Core Web Vitals\",\"section\":\"Technical\",\"summary\":\"Lighthouse lab test plus real-user field data from Google, mobile and desktop.\",\"checks\":[]},{\"slug\":\"broken-links\",\"label\":\"Broken links\",\"section\":\"Content\",\"summary\":\"Every link on the page is requested live and checked for errors and redirects.\",\"checks\":[]},{\"slug\":\"social-profiles\",\"label\":\"Social profiles\",\"section\":\"Social\",\"summary\":\"Finds every Facebook, Instagram, X, LinkedIn, YouTube and other social link and checks each one is a real, working profile.\",\"checks\":[]},{\"slug\":\"ai-access\",\"label\":\"AI & crawler access\",\"section\":\"Site & market\",\"summary\":\"Which AI and search crawlers robots.txt allows, and whether llms.txt exists.\",\"checks\":[]},{\"slug\":\"site-crawl\",\"label\":\"Site-wide issues\",\"section\":\"Site & market\",\"summary\":\"Crawls internal pages for duplicate titles, missing descriptions and thin content.\",\"checks\":[]},{\"slug\":\"keywords\",\"label\":\"Keywords overview\",\"section\":\"Site & market\",\"summary\":\"Primary keywords found on the page plus platform-focused keyword ideas.\",\"checks\":[]},{\"slug\":\"sitemap\",\"label\":\"Sitemap & robots\",\"section\":\"Site & market\",\"summary\":\"Reads robots.txt and the XML sitemap live and checks them against the pages found.\",\"checks\":[]},{\"slug\":\"security\",\"label\":\"Security & infrastructure\",\"section\":\"Site & market\",\"summary\":\"Security headers, TLS certificate, DNS and email records, domain age and hosting.\",\"checks\":[]},{\"slug\":\"traffic\",\"label\":\"Traffic overview\",\"section\":\"Site & market\",\"summary\":\"Worldwide popularity rank and a six-month trend from the Tranco list.\",\"checks\":[]}]}]]}]\n1d:[\"$\",\"section\",null,{\"id\":\"features\",\"clas