ance, links, sitemap, security, keywords and traffic.\"}]]}],[\"$\",\"li\",\"Server HTML analysis\",{\"data-reveal\":true,\"style\":{\"--d\":\"70ms\"},\"className\":\"card card-hover spot p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold\",\"children\":\"Server HTML analysis\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-muted\",\"children\":\"Fetches each page and parses its returned HTML with Cheerio; JavaScript execution is not available on Workers.\"}]]}],[\"$\",\"li\",\"Download everything\",{\"data-reveal\":true,\"style\":{\"--d\":\"140ms\"},\"className\":\"card card-hover spot p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold\",\"children\":\"Download everything\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-muted\",\"children\":\"Full report as HTML, PDF, Markdown, CSV or JSON — ready to share with a client or ticket.\"}]]}],[\"$\",\"li\",\"Safe by design\",{\"data-reveal\":true,\"style\":{\"--d\":\"0ms\"},\"className\":\"card card-hover spot p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold\",\"children\":\"Safe by design\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-muted\",\"children\":\"Strict network safeguards block private addresses, unsafe redirects and oversized responses.\"}]]}]]}]]}]\n1e:[\"$\",\"section\",null,{\"id\":\"method\",\"className\":\"scroll-mt-20 py-8\",\"children\":[\"$\",\"$L2e\",null,{}]}]\n1f:[\"$\",\"section\",null,{\"id\":\"about\",\"className\":\"scroll-mt-20 py-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-8 sm:grid-cols-[1fr_1.5fr]\",\"children\":[[\"$\",\"div\",null,{\"data-reveal\":true,\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow text-accent\",\"children\":\"About us\"}],[\"$\",\"h2\",null,{\"className\":\"mt-2 text-3xl sm:text-4xl\",\"children\":\"Show the work.\"}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted\",\"data-reveal\":true,\"style\":{\"--d\":\"80ms\"},\"children\":[[\"$\",\"p\",